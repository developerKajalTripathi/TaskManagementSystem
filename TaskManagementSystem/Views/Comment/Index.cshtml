
@{
    ViewBag.Title = "Index";
}

@model IEnumerable<TaskManagementSystem.Models.Comment>

@{
    ViewBag.Title = "Comments";
}

<style>

    .comment-list-wrapper {
        margin-top: 30px;
    }

    .page-header-custom {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 25px;
        border-radius: 15px 15px 0 0;
    }

        .page-header-custom h3 {
            margin: 0;
            font-weight: bold;
        }

    .comment-table-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.10);
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
    }

        .table th {
            background: #f4f5ff;
        }

    .btn-delete {
        background: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
    }
</style>


<div class="comment-list-wrapper">

    <div class="comment-table-card">

        <div class="page-header-custom">

            <h3>Comments</h3>

            <p style="margin:5px 0 0;">
                Task comments and collaboration
            </p>

        </div>


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success m-3">
                <strong>Success!</strong>
                @TempData["SuccessMessage"]
            </div>
        }


        <div class="table-responsive">

            <table class="table table-bordered">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Task</th>
                        <th>User</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        var task = ((List<TaskManagementSystem.Models.TaskItem>)ViewBag.Tasks)
                            .FirstOrDefault(x => x.Id == item.TaskId);

                        var user = ((List<TaskManagementSystem.Models.User>)ViewBag.Users)
                            .FirstOrDefault(x => x.Id == item.UserId);

                        <tr>

                            <td>@item.Id</td>

                            <td>
                                @(task != null ? task.Title : "Task Not Found")
                            </td>

                            <td>
                                @(user != null ? user.Name : "User Not Found")
                            </td>

                            <td>
                                @item.CommentText
                            </td>

                            <td>
                                @item.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")
                            </td>

                            <td>

                                <a href="@Url.Action("Delete", "Comment", new { id = item.Id })"
                                   class="btn-delete"
                                   onclick="return confirm('Are you sure you want to delete this comment?');">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

