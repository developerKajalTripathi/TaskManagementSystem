@model IEnumerable<TaskManagementSystem.Models.User>

@{
    ViewBag.Title = "UserManagement";
}




<style>

    .user-wrapper {
        padding: 25px 0;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #718096;
        margin-bottom: 0;
    }

    /* Top Section */

    .top-section {
        margin-bottom: 25px;
    }

    .add-user-btn {
        padding: 11px 20px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        transition: 0.3s;
    }

        .add-user-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 15px rgba(0,0,0,0.18);
        }

    /* Main Card */

    .user-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .user-card-header {
        background: white;
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f7;
    }

        .user-card-header h5 {
            margin: 0;
            font-weight: 700;
            color: #2d3748;
        }

        .user-card-header p {
            margin: 5px 0 0;
            color: #718096;
            font-size: 13px;
        }

    .user-card-body {
        background: white;
        padding: 0;
    }

    /* Table */

    .user-table {
        margin-bottom: 0;
    }

        .user-table thead {
            background: #f7fafc;
        }

            .user-table thead th {
                border-top: none;
                border-bottom: 1px solid #e2e8f0;
                padding: 15px 18px;
                color: #4a5568;
                font-size: 13px;
                font-weight: 700;
                text-transform: uppercase;
            }

        .user-table tbody td {
            padding: 16px 18px;
            vertical-align: middle;
            border-top: 1px solid #edf2f7;
            color: #4a5568;
        }

        .user-table tbody tr {
            transition: 0.2s;
        }

            .user-table tbody tr:hover {
                background: #f8fafc;
            }

    .user-name {
        font-weight: 600;
        color: #2d3748;
    }

    .user-email {
        color: #718096;
        font-size: 14px;
    }

    /* ID Circle */

    .user-id {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #edf2f7;
        color: #4a5568;
        font-weight: 600;
        font-size: 13px;
    }

    /* Badges */

    .role-badge,
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .admin-badge {
        background: #fed7d7;
        color: #c53030;
    }

    .manager-badge {
        background: #feebc8;
        color: #c05621;
    }

    .user-badge {
        background: #bee3f8;
        color: #2b6cb0;
    }

    .active-badge {
        background: #c6f6d5;
        color: #276749;
    }

    .inactive-badge {
        background: #e2e8f0;
        color: #4a5568;
    }

  
    .action-btn {
        border-radius: 7px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 600;
        margin-right: 4px;
        transition: 0.2s;
    }

        .action-btn:hover {
            transform: translateY(-1px);
        }

    .empty-row {
        text-align: center;
        padding: 45px !important;
        color: #718096;
    }

    .empty-icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    @@media (max-width: 768px) {

        .page-title {
            font-size: 23px;
        }

        .top-section {
            display: block !important;
        }

        .add-user-btn {
            margin-top: 15px;
        }

        .user-table {
            min-width: 900px;
        }
    }
</style>


<div class="container user-wrapper">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center top-section">

        <div>

            <h2 class="page-title">
                User Management
            </h2>

            <p class="page-subtitle">
                Manage system users, roles and account status
            </p>

        </div>


        <div>

            <a href="@Url.Action("Create", "User")"
               class="btn btn-primary add-user-btn">

                + Add New User

            </a>

        </div>

    </div>


    <!-- User Card -->

    <div class="card user-card">
        <div class="user-card-header">

            <h5>
                User List
            </h5>

            <p>
                View and manage all registered users
            </p>

        </div>

        <div class="user-card-body">

            <div class="table-responsive">

                <table class="table user-table">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>User</th>

                            <th>Email</th>

                            <th>Role</th>

                            <th>Status</th>

                            <th>Created Date</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {

                            foreach (var item in Model)
                            {

                                <tr>

                                    <td>

                                        <span class="user-id">
                                            @item.Id
                                        </span>

                                    </td>

                                    <td>

                                        <div class="user-name">
                                            @item.Name
                                        </div>

                                    </td>

                                    <td>

                                        <div class="user-email">
                                            @item.Email
                                        </div>

                                    </td>

                                    <td>

                                        @if (item.Role == "Admin")
                                        {
                                            <span class="role-badge admin-badge">
                                                Admin
                                            </span>
                                        }
                                        else if (item.Role == "Manager")
                                        {
                                            <span class="role-badge manager-badge">
                                                Manager
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="role-badge user-badge">
                                                User
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="status-badge active-badge">
                                                ● Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge inactive-badge">
                                                ● Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @item.CreatedAt.ToString("dd-MM-yyyy")

                                    </td>

                                    <td>

                                        <a href="@Url.Action("Edit", "User", new { id = item.Id })"
                                           class="btn btn-info btn-sm action-btn">
                                            Edit
                                        </a>


                                        <a href="@Url.Action("Delete", "User",
                                            new { id = item.Id })"
                                           class="btn btn-danger btn-sm action-btn"
                                           onclick="return confirm('Are you sure you want to delete this user?');">

                                            Delete

                                        </a>

                                    </td>

                                </tr>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="7" class="empty-row">

                                    <div class="empty-icon">
                                        👥
                                    </div>

                                    <strong>No Users Found</strong>

                                    <br />

                                    <small>
                                        Click "Add New User" to create a user.
                                    </small>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

