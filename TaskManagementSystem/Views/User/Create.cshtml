
@{
    ViewBag.Title = "Create";
}

@model TaskManagementSystem.Models.User

@{
    ViewBag.Title = "Add User";
}


<style>

    .user-form-wrapper {
        padding: 35px 0;
    }

    .form-card {
        max-width: 700px;
        margin: auto;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.10);
        overflow: hidden;
    }

    .form-header {
        padding: 22px 28px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

        .form-header h3 {
            margin: 0;
            font-weight: 700;
        }

        .form-header p {
            margin: 5px 0 0;
            opacity: 0.9;
            font-size: 14px;
        }

    .form-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 7px;
        display: block;
    }

    .form-control {
        height: 45px;
        border-radius: 8px;
        border: 1px solid #dce3ec;
        padding: 10px 13px;
        box-shadow: none;
        width: 100%;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 2px rgba(102,126,234,0.15);
        }

    .required-star {
        color: red;
    }

    .button-area {
        margin-top: 10px;
        padding-top: 20px;
        border-top: 1px solid #edf2f7;
    }

    .save-btn {
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
    }

    .back-btn {
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: 600;
        margin-left: 8px;
    }

    .text-danger {
        font-size: 13px;
    }

    @@media (max-width: 768px) {

        .form-card {
            margin: 0 15px;
        }

        .form-body {
            padding: 22px;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <strong>Success!</strong>
        @TempData["SuccessMessage"]
    </div>
}


<div class="container user-form-wrapper">

    <div class="form-card">

        <!-- Header -->

        <div class="form-header">

            <h3>
                Add New User
            </h3>

            <p>
                Create a new user account and assign a role
            </p>

        </div>


        <!-- Form Body -->

        <div class="form-body">

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Message
                </div>
            }


            @using (Html.BeginForm())
            {

                <!-- Row 1 : Name + Email -->

                <div class="row">

                    <!-- Name -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="form-label">
                                Name <span class="required-star">*</span>
                            </label>

                            @Html.TextBoxFor(x => x.Name,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter full name"
                                })

                            @Html.ValidationMessageFor(
                                x => x.Name,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>


                    <!-- Email -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="form-label">
                                Email <span class="required-star">*</span>
                            </label>

                            @Html.TextBoxFor(x => x.Email,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter email address",
                                    type = "email"
                                })

                            @Html.ValidationMessageFor(
                                x => x.Email,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>


                <!-- Row 2 : Password + Role -->

                <div class="row">

                    <!-- Password -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="form-label">
                                Password <span class="required-star">*</span>
                            </label>

                            @Html.PasswordFor(
                                x => x.PasswordHash,
                                new
                                {
                                    @class = "form-control",
                                    placeholder = "Enter password"
                                }
                            )

                            @Html.ValidationMessageFor(
                                x => x.PasswordHash,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>


                    <!-- Role -->

                    <div class="col-md-6">

                        <div class="form-group">

                            <label class="form-label">
                                Role <span class="required-star">*</span>
                            </label>

                            @Html.DropDownListFor(
                                x => x.Role,
                                new SelectList(
                                    new[]
                                    {
                                        "Admin",
                                        "Manager",
                                        "User"
                                    }
                                ),
                                "Select Role",
                                new
                                {
                                    @class = "form-control"
                                }
                            )

                            @Html.ValidationMessageFor(
                                x => x.Role,
                                "",
                                new { @class = "text-danger" }
                            )

                        </div>

                    </div>

                </div>


                <!-- Buttons -->

                <div class="button-area">

                    <button type="submit" class="btn btn-primary save-btn">
                        Save User
                    </button>


                    <a href="@Url.Action("UserManagement", "User")"
                       class="btn btn-secondary back-btn">

                        Back

                    </a>

                </div>

            }

        </div>

    </div>

</div>
