
@{
    ViewBag.Title = "CreateTeam";
}

@model TaskManagementSystem.Models.Team

@{
    ViewBag.Title = Model.Id == 0 ? "Add Team" : "Edit Team";
}

<style>

    .team-form-wrapper {
        padding: 35px 0;
    }

    .form-card {
        max-width: 700px;
        margin: auto;
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.10);
        overflow: hidden;
    }

    .form-header {
        padding: 22px 28px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

        .form-header h3 {
            margin: 0;
            font-weight: 700;
        }

        .form-header p {
            margin: 5px 0 0;
            opacity: 0.9;
            font-size: 14px;
        }

    .form-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 7px;
        display: block;
    }

    .form-control {
        height: 45px;
        border-radius: 8px;
        border: 1px solid #dce3ec;
        padding: 10px 13px;
        box-shadow: none;
        width: 100%;
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 2px rgba(102,126,234,0.15);
        }

    .required-star {
        color: red;
    }

    .button-area {
        margin-top: 10px;
        padding-top: 20px;
        border-top: 1px solid #edf2f7;
    }

    .save-btn {
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
    }

    .back-btn {
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: 600;
        margin-left: 8px;
    }

    .text-danger {
        font-size: 13px;
    }

    @@media (max-width: 768px) {

        .form-card {
            margin: 0 15px;
        }

        .form-body {
            padding: 22px;
        }
    }
</style>


<div class="container team-form-wrapper">

    <div class="form-card">

        <!-- Header -->
        <div class="form-header">

            <h3>
                @(Model.Id == 0 ? "Add New Team" : "Edit Team")
            </h3>

            <p>
                @(Model.Id == 0
                    ? "Create a new team and assign a manager"
                    : "Update team information and manager")
            </p>

        </div>


        <!-- Body -->
        <div class="form-body">

            <!-- Error Message -->
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger">
                    <strong>Error!</strong>
                    @ViewBag.Message
                </div>
            }


            @using (Html.BeginForm())
            {
                @Html.HiddenFor(x => x.Id)

            <div class="row">
                <div class="col-6">
                    <div class="form-group">

                        <label class="form-label">
                            Team Name
                            <span class="required-star">*</span>
                        </label>

                        @Html.TextBoxFor(
                            x => x.Name,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter team name"
                            }
                        )

                        @Html.ValidationMessageFor(
                            x => x.Name,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>
                <div class="col-6">

                    <div class="form-group">

                        <label class="form-label">
                            Manager
                            <span class="required-star">*</span>
                        </label>

                        @Html.DropDownListFor(
                            x => x.ManagerId,
                            new SelectList(
                                ViewBag.Managers,
                                "Id",
                                "Name"
                            ),
                            "Select Manager",
                            new
                            {
                                @class = "form-control"
                            }
                        )

                        @Html.ValidationMessageFor(
                            x => x.ManagerId,
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>
            </div>
                <!-- Team Name -->
               

                <!-- Manager -->
               

                <!-- Buttons -->
                <div class="button-area">

                    <button type="submit"
                            class="btn btn-primary save-btn">

                        @(Model.Id == 0
                            ? "Save Team"
                            : "Update Team")

                    </button>


                    <a href="@Url.Action("Index", "Team")"
                       class="btn btn-secondary back-btn">

                        Back

                    </a>

                </div>

            }

        </div>

    </div>

</div>
