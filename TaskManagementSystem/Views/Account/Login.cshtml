<style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #667eea, #764ba2);
        min-height: 100vh;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .login-wrapper {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .login-card {
        width: 420px;
        max-width: 100%;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }

    /* Header */

    .login-header {
        background: linear-gradient(135deg, #4e73df, #6f42c1);
        color: white;
        text-align: center;
        padding: 30px 20px;
    }

    .login-icon {
        width: 65px;
        height: 65px;
        background: #ffffff;
        color: #5a4fcf;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 28px;
        font-weight: 700;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }

    .login-header h2 {
        margin: 0;
        font-size: 28px;
        font-weight: 600;
    }

    .login-header p {
        margin: 8px 0 0;
        font-size: 14px;
        opacity: 0.9;
    }

    /* Body */

    .login-body {
        padding: 32px;
    }

    /* Form Group */

    .input-group-custom {
        width: 100%;
        margin-bottom: 20px;
    }

    /* Label */

    .form-label {
        display: block;
        width: 100%;
        font-weight: 600;
        color: #444;
        margin-bottom: 8px;
        font-size: 14px;
    }

    /* Input */

    .input-group-custom input {
        display: block;
        width: 100%;
        height: 48px;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        padding: 10px 15px;
        font-size: 14px;
        color: #333;
        background: #ffffff;
        outline: none;
        transition: all 0.3s ease;
    }

        .input-group-custom input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

        .input-group-custom input::placeholder {
            color: #999;
        }

    /* Login Button */

    .login-btn {
        display: block;
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #4e73df, #6f42c1);
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(78, 115, 223, 0.35);
        }

        .login-btn:active {
            transform: translateY(0);
        }

    /* Error Message */

    .alert {
        border-radius: 8px;
        font-size: 14px;
        margin-bottom: 20px;
        padding: 10px 12px;
    }

    /* Footer */

    .login-footer {
        text-align: center;
        color: #888;
        font-size: 13px;
        margin-top: 22px;
        line-height: 1.7;
    }

    /* Responsive */

    @@media (max-width: 500px) {

        .login-wrapper {
            padding: 20px 15px;
        }

        .login-card {
            width: 100%;
        }

        .login-body {
            padding: 25px 20px;
        }

        .login-header h2 {
            font-size: 24px;
        }
    }
</style>

<div class="login-wrapper">

    <div class="login-card">

        <!-- Header -->
        <div class="login-header">

            <div class="login-icon">
                T
            </div>

            <h2>Task Management</h2>

            <p>Sign in to manage your tasks</p>

        </div>


        <!-- Body -->
        <div class="login-body">

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Message
                </div>
            }


            @using (Html.BeginForm("Login", "Account", FormMethod.Post))
            {

                <!-- Email -->
                <div class="input-group-custom">

                    <label class="form-label">
                        Email Address
                    </label>

                    <input type="email"
                           name="Email"
                           placeholder="Enter your email"
                           required />

                </div>


                <!-- Password -->
                <div class="input-group-custom">

                    <label class="form-label">
                        Password
                    </label>

                    <input type="password"
                           name="Password"
                           placeholder="Enter your password"
                           required />

                </div>


                <!-- Login Button -->
                <button type="submit" class="login-btn">
                    Login
                </button>

            }


            <div class="login-footer">
                Task Management System
                <br />
                © @DateTime.Now.Year All Rights Reserved
            </div>

        </div>

    </div>

</div>

