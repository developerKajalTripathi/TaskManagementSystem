
@model List<TaskManagementSystem.Models.Notification>

@{
    ViewBag.Title = "Notification";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header"
             style="background:linear-gradient(135deg,#667eea,#764ba2); color:white;">

            <h3 class="mb-0">Notifications</h3>

        </div>

        <div class="card-body">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    No notifications found.
                </div>
            }
            else
            {
                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Message</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Id
                                </td>

                                <td>
                                    @item.Message
                                </td>

                                <td>
                                   


                                    @if (item.IsRead)
                                    {
                                        <span class="badge" style="background-color:black; color:white;">
                                            Read
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background-color:black; color:white;">
                                            Unread
                                        </span>
                                    }


                                </td>

                                <td>
                                    @item.CreatedAt.ToString("dd-MM-yyyy hh:mm tt")
                                </td>

                                <td>

                                    @if (!item.IsRead)
                                    {
                                        <a href="@Url.Action("MarkAsRead", "Notification", new { id = item.Id })"
                                           class="btn btn-primary btn-sm">
                                            Mark Read
                                        </a>
                                    }

                                    <a href="@Url.Action("Delete", "Notification", new { id = item.Id })"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this notification?');">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>

</div>
